# Copy to .env and fill in real values. .env is git-ignored.

# EIA Open Data API key — register free at https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Secret used to sign auth tokens (JWT). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Where extracted and modeled Parquet files are stored
DATA_DIR=./data
